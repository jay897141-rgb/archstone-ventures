# Copy to .env and fill in for production. If MONGODB_URI is left blank,
# the API runs in dev mode: enquiries are accepted and validated, but held
# only in memory (not persisted) — see db.py for details.

MONGODB_URI=
MONGODB_DB=archstone
MONGODB_COLLECTION=enquiries

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173
