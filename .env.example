# Copy this file to .env.local (Vite auto-loads it, and it's already
# git-ignored) and point it at wherever the FastAPI backend is running.
#
# EnquiryForm.jsx reads this as: import.meta.env.VITE_API_URL
# If unset, it defaults to http://localhost:8000 — correct for local dev
# when the backend is run as described in the root README.

VITE_API_URL=http://localhost:8000

# GitHub Pages project path. Set to / for a custom domain deployment.
VITE_BASE_PATH=/archstone-ventures/
